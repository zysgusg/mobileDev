<!--pages/my/my.wxml-->
<!-- 个人中心头部 -->
<view class="myHeader">
  <block wx:if="{{isLogin}}">
    <image class="avatar" src="{{src}}" mode="aspectFill"></image>
    <view class="user-info">
      <text class="nickname">{{nickName}}</text>
      <text class="welcome">欢迎来到 OUC 新闻网</text>
    </view>
  </block>
  <view class="login-box" wx:else>
    <image class="avatar" src="../../images/my.png" mode="aspectFill"></image>
    <button class="login-btn" bindtap="handleLogin">未登录，点此登录</button>
  </view>
</view>

<!-- 登录弹窗：点击登录按钮后弹出，可选择微信账号真实信息或匿名信息 -->
<view class="login-mask" wx:if="{{showLoginPopup}}" bindtap="closeLoginPopup">
  <view class="login-popup" catchtap="noop">
    <!-- 第一步：选择登录方式 -->
    <block wx:if="{{loginMode === 'choose'}}">
      <text class="popup-title">选择登录方式</text>
      <button class="popup-btn primary" bindtap="useRealInfo">使用微信账号头像昵称</button>
      <button class="popup-btn" bindtap="useAnonymous">使用匿名头像昵称</button>
    </block>
    <!-- 第二步：官方头像昵称填写能力（新端获取真实头像昵称的唯一途径） -->
    <block wx:else>
      <text class="popup-title">完善头像昵称</text>
      <button class="popup-avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="popup-avatar" src="{{src}}" mode="aspectFill"></image>
      </button>
      <text class="popup-tip">点击头像选择，可使用微信头像</text>
      <input class="popup-input" type="nickname" placeholder="点击填写微信昵称" bindinput="onNicknameInput" />
      <button class="popup-btn primary" bindtap="confirmRealInfo">确认登录</button>
    </block>
  </view>
</view>
<!-- 收藏列表 -->
<view class="myFavorite">
  <view class="section-title">
    <text class="section-bar"></text>
    <text>我的收藏（{{number}}）</text>
  </view>
  <view class="news-list" wx:if="{{number > 0}}">
    <view class='list-item' wx:for="{{newsList}}" wx:for-item="news" wx:key="{{news.id}}">
      <image src='{{news.poster}}' mode="aspectFill"></image>
      <view class="list-info">
        <text class="list-title" bindtap='goToDetail' data-id='{{news.id}}'>{{news.title}}</text>
        <text class="list-date">{{news.add_date}}</text>
      </view>
    </view>
  </view>
  <view class="empty" wx:else>
    <text>暂无收藏，去首页逛逛吧～</text>
  </view>
</view>
<!-- 浏览历史 -->
<view class="myHistory">
  <view class="section-title">
    <text class="section-bar"></text>
    <text>浏览历史（{{historyList.length}}）</text>
    <text class="clear-history" bindtap="clearHistory">清空</text>
  </view>
  <view class="news-list" wx:if="{{historyList.length > 0}}">
    <view class='list-item' wx:for="{{historyList}}" wx:for-item="news" wx:key="{{news.id}}">
      <image src='{{news.poster}}' mode="aspectFill"></image>
      <view class="list-info">
        <text class="list-title" bindtap='goToDetail' data-id='{{news.id}}'>{{news.title}}</text>
        <text class="list-date">{{news.time}}</text>
      </view>
    </view>
  </view>
  <view class="empty" wx:else>
    <text>暂无浏览历史</text>
  </view>
</view>
<!-- 账户操作 -->
<view class="account-ops" wx:if="{{isLogin}}">
  <button class="op-btn switch" bindtap="switchAccount">切换账号</button>
  <button class="op-btn logout" bindtap="logout">注销登录</button>
</view>
