page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F6F7;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
  padding: 24rpx;
}

.log-item {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  text-align: left;
  font-size: 28rpx;
  color: #333333;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.log-item:last-child {
  padding-bottom: env(safe-area-inset-bottom);
}
