.container {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1.5;
  text-align: center;
  color: #222222;
  padding: 30rpx 20rpx;
}

.poster {
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}

.poster image {
  width: 100%;
  display: block;
}

.content {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.content text {
  text-align: justify;
  font-size: 30rpx;
  line-height: 1.9;
  color: #333333;
  user-select: auto;
}

.add_date {
  font-size: 26rpx;
  color: #999999;
  text-align: right;
  line-height: 30rpx;
  margin-top: 24rpx;
  padding-right: 10rpx;
}

.fav-btn {
  margin-top: 44rpx;
  display: flex;
  justify-content: center;
}

button.btn {
  width: 360rpx;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin: 0;
  padding: 0;
  /* 让文字在按钮内水平垂直居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

button.btn::after {
  border: none;
}

/* 未收藏：白底 + 蓝色文字 */
button.btn-add {
  background: #ffffff;
  color: #328EEB;
  border: 2rpx solid #328EEB;
}

/* 已收藏：蓝底 + 白色文字 */
button.btn-added {
  background: linear-gradient(135deg, #328EEB, #65B0FF);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(50, 142, 235, 0.35);
}
