.container {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1.5;
  text-align: center;
  color: #222222;
  padding: 30rpx 20rpx;
}

.poster {
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}

.poster image {
  width: 100%;
  display: block;
}

.content {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.content text {
  text-align: justify;
  font-size: 30rpx;
  line-height: 1.9;
  color: #333333;
  user-select: auto;
}

.add_date {
  font-size: 26rpx;
  color: #999999;
  text-align: right;
  line-height: 30rpx;
  margin-top: 24rpx;
  padding-right: 10rpx;
}

.fav-btn {
  margin-top: 44rpx;
  display: flex;
  gap: 20rpx;
}

button.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin: 0;
  padding: 0;
  /* 让文字在按钮内水平垂直居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

button.btn::after {
  border: none;
}

/* 未收藏/未点赞：白底 + 蓝色文字 */
button.btn-add, button.btn-like {
  background: #ffffff;
  color: #328EEB;
  border: 2rpx solid #328EEB;
}

/* 已收藏/已点赞：蓝底 + 白色文字 */
button.btn-added, button.btn-liked {
  background: linear-gradient(135deg, #328EEB, #65B0FF);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(50, 142, 235, 0.35);
}

/* 评论区 */
.comment-section {
  margin-top: 44rpx;
}

.comment-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.comment-bar {
  width: 8rpx;
  height: 32rpx;
  background: #328EEB;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.comment-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.comment-input {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  background: #ffffff;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333333;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

button.comment-btn {
  flex-shrink: 0;
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  background: linear-gradient(135deg, #328EEB, #65B0FF);
  color: #ffffff;
  text-align: center;
}

button.comment-btn::after {
  border: none;
}

.comment-list {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.comment-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.c-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #eeeeee;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.c-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.c-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c-name {
  font-size: 26rpx;
  color: #999999;
}

.c-time {
  font-size: 22rpx;
  color: #bbbbbb;
}

.c-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.6;
  margin-top: 10rpx;
  word-break: break-all;
}

.comment-empty {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 60rpx 0;
}
