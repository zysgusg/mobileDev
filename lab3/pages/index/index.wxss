/* 幻灯片区域 */
.swiper-wrap {
  padding: 24rpx 24rpx 12rpx;
}

swiper.banner {
  height: 360rpx;
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(50, 142, 235, 0.25);
}

swiper.banner image {
  height: 100%;
  width: 100%;
  border-radius: 20rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx 0;
}

.search-input {
  height: 76rpx;
  border-radius: 38rpx;
  background: #ffffff;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #333333;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 搜索无结果提示 */
.search-empty {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
