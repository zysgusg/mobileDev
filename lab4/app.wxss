/**app.wxss**/
page {
  background: linear-gradient(180deg, #3a7bd5 0%, #6aa5f0 100%);
}

/*页面容器样式*/
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-evenly;
  padding: 30rpx;
  box-sizing: border-box;
}

/*顶端标题样式*/
.title {
  font-size: 22pt;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.25);
}
