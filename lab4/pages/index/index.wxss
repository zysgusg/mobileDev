/**index.wxss**/
/*顶部标题区域*/
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
}

/*关卡列表区域*/
.levelBox {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 8rpx;
}

/*单个关卡区域*/
.box {
  width: 43%;
  box-sizing: border-box;
  margin-bottom: 40rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 22rpx;
  padding: 22rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 14rpx rgba(20, 70, 140, 0.16);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

/*点击时的反馈效果*/
.box-hover {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(20, 70, 140, 0.14);
}

/*选关图片容器*/
.imgWrap {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 14rpx;
  background: #eef3fb;
}

/*选关图片*/
.levelImg {
  width: 100%;
  height: 100%;
}

.boxText {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  letter-spacing: 2rpx;
}
