<!--index.wxml-->
<navigation-bar title="个人名片" back="{{false}}" color="#1F2937" background="#FFFFFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <!-- 顶部展示 -->
  <view class="hero fade-up">
    <image class="banner" mode="widthFix" src="../../img/head.jpg"></image>
    <view class="hero-info">
      <view class="hero-sub">{{name}} · {{school}} · {{major}}</view>
      <view class="hero-tags">
        <text class="hero-tag" wx:for="{{heroTags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="hero-actions">
        <button class="btn btn-primary" bindtap="copyEmail">复制邮箱</button>
        <button class="btn btn-outline" open-type="share">分享名片</button>
      </view>
    </view>
  </view>

  <!-- 关于我 -->
  <view class="section fade-up delay-1">
    <view class="section-title">关于我</view>
    <view class="panel">
      <view class="line" wx:for="{{intro}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <!-- 个人标签 -->
  <view class="section fade-up delay-2">
    <view class="section-title">个人标签</view>
    <view class="panel tags-panel">
      <view class="tag" wx:for="{{tags}}" wx:key="*this">#{{item}}</view>
    </view>
  </view>

  <!-- 电子名片 -->
  <view class="section fade-up delay-3">
    <view class="section-title">电子名片</view>
    <view class="card">
      <image class="bg" mode="widthFix" src="../../img/bg.png"></image>
      <image class="logo" mode="widthFix" src="../../img/ouc.png"></image>
      <view class="info">
        <view class="name">{{name}}</view>
        <view class="desc">{{school}} 信息学部 计算机科学与技术专业</view>
        <view class="email">{{email}}</view>
      </view>
    </view>
  </view>

</scroll-view>
