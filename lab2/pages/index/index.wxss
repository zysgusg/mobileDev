/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column; 
}
image{
  width: 100%;
}
.commet{
  text-align: center;
  font-size: 14px;
  color: 999;
}
.body{
  padding: 30px;
  line-height: 2;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.title{
  font-size: 24px;
  padding-top: 10px;
  padding-bottom: 10px;
  font-weight: bold;
}
.line{
  padding-top: 5px;
  padding-bottom: 5px;
}
.card{
  margin: 10px;
  position: relative;
}
.bg{
  width: 100%;
  border-radius: 5px;
  box-shadow: 0 0 5px #5F687E;
}
.logo{
  width: 125px;
  position: absolute;
  top:10px;
  right:20px;
}
.info{
  position: absolute;
  left: 25px;
  bottom: 25px;
  font-size: 15px;
  color: #ffffff;
}
.name{
  font-weight: bold;
}
.desc{
  margin-bottom: 10px;
}