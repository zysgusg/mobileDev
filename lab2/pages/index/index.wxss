/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F6F8FC;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* ===== 顶部展示 ===== */
.hero {
  background: #FFFFFF;
}

.banner {
  width: 100%;
  display: block;
  border-radius: 8rpx 8rpx 8rpx 8rpx;
}

.hero-info {
  padding: 40rpx 40rpx 0;
  text-align: center;
}

.hero-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F2937;
  letter-spacing: 4rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.hero-tags {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.hero-tag {
  font-size: 24rpx;
  color: #2563EB;
  background: #EAF2FF;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.hero-actions {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
  gap: 28rpx;
}

.btn {
  font-size: 28rpx;
  line-height: 1;
  padding: 22rpx 56rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
}

button.btn::after {
  border: none;
}

.btn-primary {
  background: #2563EB;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.28);
}

.btn-outline {
  background: #FFFFFF;
  color: #2563EB;
  border: 2rpx solid #BFDBFE;
}

/* ===== 分区 ===== */
.section {
  padding: 32rpx 32rpx 0;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  padding: 0 8rpx 20rpx;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #2563EB;
  margin-right: 16rpx;
}

.panel {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.05);
}

.line {
  font-size: 27rpx;
  line-height: 1.9;
  color: #4B5563;
  text-align: justify;
}

.line + .line {
  margin-top: 20rpx;
}

/* ===== 个人标签 ===== */
.tags-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  font-size: 26rpx;
  color: #2563EB;
  background: #EAF2FF;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
}

/* ===== 电子名片 ===== */
.card {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(31, 41, 55, 0.14);
}

.bg {
  width: 100%;
  display: block;
}

.logo {
  width: 200rpx;
  position: absolute;
  top: 24rpx;
  right: 28rpx;
}

.info {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  color: #FFFFFF;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.desc {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.email {
  font-size: 22rpx;
  opacity: 0.75;
}

/* ===== 入场动画 ===== */
.fade-up {
  opacity: 0;
  animation: fadeUp 0.6s ease forwards;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.delay-1 { animation-delay: 0.12s; }
.delay-2 { animation-delay: 0.24s; }
.delay-3 { animation-delay: 0.36s; }
.delay-4 { animation-delay: 0.48s; }
